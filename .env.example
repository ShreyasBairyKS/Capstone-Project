# ==============================================================================
# VisionQAI - Workstation Environment Configuration
# Copy this file to '.env' at the repository root
# ==============================================================================

# Versioning
VISIONQAI_ENGINE_VERSION=v1
VISIONQAI_FRONTEND_VERSION=v1
VISIONQAI_BACKEND_VERSION=v1

# TensorRT Dynamic Batching
VISIONQAI_TRT_BATCH_SIZE=3
VISIONQAI_TRT_MAX_BATCH=4
VISIONQAI_FORCE_RECOMPILE=0

# Conveyor Settings
VISIONQAI_CONVEYOR_BPM=300
VISIONQAI_TEST_DATA_DIR=test

# Logging
VISIONQAI_LOG_LEVEL=INFO
# ==============================================================================
# File paths (all optional). Absolute paths work anywhere; relative paths are
# resolved against the repository root, never the current working directory.
# Docker: these are HOST paths, mounted into the container automatically.
# ==============================================================================
# Folder of images used by the "Simulate" button / auto-conveyor for Station 1 (Cap).
#   Layout A: one subfolder per bottle with up to 3 images (front/rear/side)
#   Layout B: flat images, grouped 3 per bottle in sorted order
# VISIONQAI_CAP_SIM_DIR=simulation/cap
# Folder of bottle profile images for Station 2 (Fill). Default: pipeline/fill_level/sample_images
# VISIONQAI_FILL_SIM_DIR=pipeline/fill_level/sample_images
# Cap model checkpoint (standalone mode; Docker mounts the default location)
# VISIONQAI_CAP_MODEL_PATH=YOLOv11seg-X model/YOLO_TrainingScripts/student_yolo11m_distilled/weights/best.pt
# Fill model folder (bottle_detector_best.pt, best.pt / water_surface_best.pt, compiled engines)
# VISIONQAI_FILL_MODELS_DIR=models/fill-level-detector
# SQLite databases + saved bottle bundles for both stations
# VISIONQAI_AUDIT_DIR=audit

# Station 2: Fill Level Inspection Configuration
VISIONQAI_FILL_ENGINE_VERSION=v1
VISIONQAI_FILL_FORCE_RECOMPILE=0
VISIONQAI_FILL_UNDERFILL_THRESHOLD=0.40
VISIONQAI_FILL_OVERFILL_THRESHOLD=0.85
