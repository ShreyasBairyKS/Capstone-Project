# ==============================================================================
# VisionQAI - Target Machine Environment Configuration
# Copy this file to '.env' at the repository root on the target PC
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Versioning System (Engine & Containers)
# ------------------------------------------------------------------------------
# Set the desired engine version. Legacy is 'v0' (best.engine).
# The current dynamic batched engine is 'v1' (best_v1.engine).
VISIONQAI_ENGINE_VERSION=v1

# Tag for frontend and backend Docker images
VISIONQAI_FRONTEND_VERSION=v1
VISIONQAI_BACKEND_VERSION=v1

# ------------------------------------------------------------------------------
# 2. Hardware Acceleration & Dynamic TensorRT Batching
# ------------------------------------------------------------------------------
# Number of synchronized camera views per bottle (default: 3)
VISIONQAI_TRT_BATCH_SIZE=3

# Maximum dynamic batch profile headroom (default: 4)
VISIONQAI_TRT_MAX_BATCH=4

# Set to 1 to force recompilation of the TensorRT engine on startup
VISIONQAI_FORCE_RECOMPILE=0

# ------------------------------------------------------------------------------
# 3. Industrial Conveyor & Simulation Settings
# ------------------------------------------------------------------------------
# Target line speed in Bottles Per Minute (BPM). 300 BPM = 5 bottles/sec
VISIONQAI_CONVEYOR_BPM=300

# Path to disk-based test corpus for stress testing & verification
# Target structure: <TEST_DATA_DIR>/bottle_001/image1.png, image2.png, image3.png
VISIONQAI_TEST_DATA_DIR=test

# ------------------------------------------------------------------------------
# 4. Camera Ingestion Sources (For physical/RTSP camera integration)
# ------------------------------------------------------------------------------
# Camera 1 (Side View 0 deg) - Device index (0, 1, 2) or rtsp:// stream URL
VISIONQAI_CAMERA_FRONT_SOURCE=0

# Camera 2 (Side View 120 deg)
VISIONQAI_CAMERA_REAR_SOURCE=1

# Camera 3 (Side View 240 deg)
VISIONQAI_CAMERA_SIDE_SOURCE=2

# ------------------------------------------------------------------------------
# 5. Logging & Diagnostics
# ------------------------------------------------------------------------------
VISIONQAI_LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 6. Station 2: Fill Level Inspection
# ------------------------------------------------------------------------------
# TensorRT engine version tag for fill models (bottle_detector_<v>.engine, water_surface_<v>.engine)
VISIONQAI_FILL_ENGINE_VERSION=v1

# Set to 1 to delete and recompile the fill TensorRT engines on next load
VISIONQAI_FILL_FORCE_RECOMPILE=0

# Nominal fill band (fraction of bottle height). Applies to gate, engine, overlay ruler and /api/fill/health
VISIONQAI_FILL_UNDERFILL_THRESHOLD=0.40
VISIONQAI_FILL_OVERFILL_THRESHOLD=0.85

# ------------------------------------------------------------------------------
# 7. File Paths (all optional)
# ------------------------------------------------------------------------------
# Absolute paths work anywhere; relative paths resolve against the repository root.
# Docker: these are HOST paths and are mounted into the container automatically.
# Simulation images for the "Simulate" button (Station 1: subfolder per bottle, or flat images grouped by 3)
# VISIONQAI_CAP_SIM_DIR=D:/bottle_test_images/cap
# Simulation images for Station 2 (flat folder of bottle profile images)
# VISIONQAI_FILL_SIM_DIR=D:/bottle_test_images/fill
# Model locations (the fill models are NOT in git; copy them here manually)
# VISIONQAI_FILL_MODELS_DIR=models/fill-level-detector
# VISIONQAI_CAP_MODEL_PATH=YOLOv11seg-X model/YOLO_TrainingScripts/student_yolo11m_distilled/weights/best.pt
# Databases and saved bottle bundles
# VISIONQAI_AUDIT_DIR=audit
