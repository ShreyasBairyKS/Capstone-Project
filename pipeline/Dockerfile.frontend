# ==============================================================================
# VisionQAI - Frontend Dashboard Container
# Multi-stage build: Compiles React + Vite and serves via high-performance Nginx
# ==============================================================================

# Stage 1: Build React Assets
FROM node:20-alpine AS builder

WORKDIR /app

COPY pipeline/frontend/package*.json ./
RUN npm install

COPY pipeline/frontend/ ./
RUN npm run build

# Stage 2: Production Nginx Server
FROM nginx:alpine

# Remove default configuration
RUN rm /etc/nginx/conf.d/default.conf

# Copy custom reverse-proxy configuration
COPY pipeline/nginx.conf /etc/nginx/conf.d/default.conf

# Copy compiled static assets from builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
